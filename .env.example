# Configuración de Ollama
OLLAMA_HOST=http://127.0.0.1:11434

# Modelos de Ollama utilizados
# Hermes 3 afinado sobre Llama 3.2, cuantizado para tarjetas AMD RX
OLLAMA_CHAT_MODEL=hermes3:3b-llama3.2-q4_K_M

# Modelo para embeddings (RAG)
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# VRAM de la RX en GB: 4, 6, 8, 12, 16 o 24. Ajusta el contexto que se envía a la GPU.
RX_VRAM=8

# Capas del modelo que Ollama debe subir a la GPU. 999 = todas.
OLLAMA_NUM_GPU=999

# Puerto del motor Node (JavaScript puro)
LLM_PORT=43124

# Configuración del sistema RAG
# Tamaño de chunks para dividir documentos (en palabras)
RAG_CHUNK_SIZE=180

# Overlap entre chunks para mantener contexto
RAG_CHUNK_OVERLAP=30

# Base de conocimiento compartida por todos los proyectos (guías Scrum, estándares, ejemplos)
RAG_BASE_PROYECTO=base_conocimiento
# Parte del contexto reservada para la base de conocimiento (0 a 1)
RAG_BASE_PORCION=0.35
# Fragmentos máximos que se traen de la base y similitud mínima para usarlos
RAG_BASE_FRAGMENTOS=12
RAG_BASE_MIN_SIMILITUD=0.4

# Tablero de tareas: horas de trabajo por persona al día, puntos máximos por sprint
# y días hábiles de un sprint cuando el plan no los indica
HORAS_POR_DIA=6
VELOCIDAD_SPRINT=20
DIAS_SPRINT=10

# Exportar el tablero a Trello (gratis). API key: https://trello.com/power-ups/admin
# Token: https://trello.com/1/authorize?expiration=never&scope=read,write&response_type=token&key=TU_API_KEY
TRELLO_API_KEY=
TRELLO_TOKEN=

# Exportar el tablero a Jira Cloud (plan Free). Token: https://id.atlassian.com/manage-profile/security/api-tokens
# JIRA_SITIO: tu-empresa (o tu-empresa.atlassian.net). JIRA_PROYECTO: clave del proyecto, p. ej. SCRUM
JIRA_SITIO=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROYECTO=

# PostgreSQL (no necesita extensiones). La base se crea sola si no existe.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=tu_contraseña
PGDATABASE=scrum_rag

# Base SQLite antigua, solo para: node engine/cli.js migrar-sqlite
DATABASE_PATH=./data/scrum-llm.db
