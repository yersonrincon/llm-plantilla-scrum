# Configuración de Ollama
OLLAMA_HOST=http://127.0.0.1:11434

# Puerto de la aplicación Next.js (opcional, por defecto 3000)
PORT=43123

# Modelos de Ollama utilizados
# Hermes 3 afinado sobre Llama 3.2, cuantizado para tarjetas AMD RX
OLLAMA_CHAT_MODEL=hermes3:3b-llama3.2-q4_K_M

# Modelo para embeddings (RAG)
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# VRAM de la RX en GB: 4, 6, 8, 12, 16 o 24. Ajusta el contexto que se envía a la GPU.
RX_VRAM=8

# Capas del modelo que Ollama debe subir a la GPU. 999 = todas.
OLLAMA_NUM_GPU=999

# Puerto del motor Node (JavaScript puro)
LLM_PORT=43124

# Configuración del sistema RAG
# Tamaño de chunks para dividir documentos (en palabras)
RAG_CHUNK_SIZE=180

# Overlap entre chunks para mantener contexto
RAG_CHUNK_OVERLAP=30

# Número de chunks más relevantes a recuperar
RAG_TOP_K=5

# Configuración de la base de datos
# Ruta relativa desde el root del proyecto
DATABASE_PATH=./data/scrum-llm.db
