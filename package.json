{
  "name": "scrum-llm-assistant",
  "version": "1.0.0",
  "description": "Sistema LLM con Hermes + Ollama para generación de plantillas Scrum con RAG local",
  "private": true,
  "scripts": {
    "dev": "next dev -p 43123",
    "build": "next build",
    "start": "next start -p 43123",
    "lint": "eslint",
    "init-db": "node scripts/init-db.js",
    "setup": "npm install && npm run init-db",
    "check-ollama": "curl -s http://localhost:11434/api/version || echo 'Ollama no está corriendo. Ejecuta: ollama serve'"
  },
  "dependencies": {
    "@langchain/community": "^1.1.29",
    "@langchain/ollama": "^1.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "langchain": "^1.6.0",
    "natural": "^8.2.6",
    "next": "16.4.3",
    "ollama": "^0.6.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
