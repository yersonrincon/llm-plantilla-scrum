{
  "name": "scrum-llm-assistant",
  "version": "1.0.0",
  "description": "Sistema LLM con Hermes + Ollama para generación de plantillas Scrum con RAG local",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node engine/server.js",
    "dev": "node --watch engine/server.js",
    "init-db": "node engine/cli.js init",
    "migrar": "node engine/cli.js migrar-sqlite",
    "llm": "node engine/cli.js",
    "llm:serve": "node engine/server.js",
    "setup": "npm install && npm run init-db",
    "check-ollama": "node engine/cli.js salud"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "unpdf": "^2.1.0"
  }
}
